{
    "manifest_version": 2.0,
    "id": "zabbix-graphtrees",
    "name": "Zabbix Graph Trees",
    "author": "火星小刘",
    "url": "https://github.com/X-Mars/zabbix_modules",
    "version": "1.1.0",
    "namespace": "ZabbixGraphTrees",
    "description": "Browse host groups and hosts in a tree, filter monitoring items by tag, and view auto-refreshing charts.",
    "actions": {
        "graphtrees": {
            "class": "GraphTrees",
            "view": "graphtrees"
        },
        "graphtrees.data": {
            "class": "GraphTreesData"
        }
    }
}
