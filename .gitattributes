# Normalize line endings automatically
* text=auto eol=lf

# More precise settings per file type (recommended)
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.html text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files are left untouched
*.png binary
*.jpg binary
*.gif binary
*.exe binary