{
    "manifest_version": 2.0,
    "id": "zabbix-switch-visual",
    "type": "widget",
    "name": "Zabbix Switch Visual",
    "namespace": "SwitchVisual",
    "version": "1.6.0",
    "author": "Mauro Serafini/火星小魏/火星小刘",
    "description": "Visualize switch chassis, RJ45 and SFP port status, link speed, traffic trends, and device health in a dashboard widget.",
    "widget": {
        "js_class": "CWidgetSwitchVisual"
    },
    "actions": {
        "widget.zabbix-switch-visual.view": {
            "class": "WidgetView"
        },
        "widget.zabbix-switch-visual.sparkline": {
            "class": "WidgetSparkline"
        },
        "switchvisual.view": {
            "class": "StandaloneView",
            "view": "widget.view"
        }
    },
    "assets": {
        "js": [
            "class.widget.js"
        ]
    }
}
